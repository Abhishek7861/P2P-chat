# Copy to .env and edit. Docker Compose reads it automatically.

# Must match the database volume. Postgres only applies these when it first creates the volume,
# so changing them later breaks the backend's login unless you also change the user in Postgres.
DB_USER=p2p
DB_PASSWORD=p2p

# Signs login tokens. Required before the app is reachable by anyone else. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Browser origins allowed to call the API, comma-separated. Wildcards are allowed.
# Add https://*.trycloudflare.com to use a Cloudflare quick tunnel.
CORS_ORIGINS=http://localhost:5173
